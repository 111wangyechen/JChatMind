          "id": "kb-001",
          "name": "产品信息库",
          "documents": [
            {
              "id": "doc-001",
              "content": "JChatMind产品定价方案：个人版免费，专业版每月99元，企业版每月599元，旗舰版每月1999元。所有付费版本支持7天免费试用。"
            }
          ]
        }
      },
      "expected": {
        "shouldCallTool": false,
        "expectedToolName": null,
        "expectedKeywords": ["599", "企业版", "每月"],
