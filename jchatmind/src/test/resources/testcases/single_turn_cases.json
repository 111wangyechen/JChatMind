        "shouldCallTool": false,
        "expectedToolName": null,
        "expectedKeywords": ["Java", "Python", "优点", "缺点", "对比"],
        "shouldContain": ["Java", "Python"],
        "shouldNotContain": [],
        "expectedBehavior": "系统性地对比两种语言的优缺点"
      },
