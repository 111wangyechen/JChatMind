      "expected": {
        "shouldCallTool": false,
        "expectedToolName": null,
        "expectedKeywords": ["无法", "不支持", "邮件"],
        "shouldContain": [],
        "shouldNotContain": [],
        "expectedBehavior": "告知用户当前没有发送邮件的工具"
      },
      "evaluationCriteria": {
        "accuracyWeight": 1.0,
        "hallucinationCheck": false,
        "relevanceCheck": true
      }
    },
